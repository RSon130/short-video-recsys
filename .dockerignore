.git
.gitattributes
__pycache__
*.pyc
*.pyo
.pytest_cache
logs/
checkpoints/
.env
*.egg-info

# Training inputs and analysis outputs never belong in an image.
# datastore/processed/ now holds phase 2 analysis artifacts as well as the
# phase 1 model files — the phase 2b score dump alone is 615 MB, and copying it
# made the deploy image 2.3 GB.
datastore/raw/
datastore/processed/
datastore/processed_small/

# datastore/serving/ (~2 MB: the item table and per-user seen index) is
# deliberately NOT excluded — the deploy stage bakes it into the image.
# See Dockerfile.cpu.
