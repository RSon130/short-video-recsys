# CPU image — the default for Tier 1 development and for Cloud Run.
#
# Why CPU is the default:
#   The Tier 1 dataset (KuaiRec small_matrix, ~1K x 1K) trains in minutes on CPU.
#   The CUDA base image is a ~7 GB pull to save a few minutes of training, and
#   faiss-gpu adds a class of driver-compatibility failures unrelated to this
#   project. Cloud Run is CPU-only, so this is also the image that ships.
#
# The GPU image (./Dockerfile) is kept for Tier 2, where big_matrix (~12.5M rows)
# makes GPU training genuinely worthwhile.

FROM python:3.11-slim AS runtime

# libgomp1 is required by faiss (OpenMP runtime).
RUN apt-get update && apt-get install -y --no-install-recommends \
    libgomp1 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Install torch from the CPU-only wheel index first — the default PyPI wheel
# pulls ~2 GB of unused CUDA libraries.
RUN pip install --no-cache-dir \
    --index-url https://download.pytorch.org/whl/cpu \
    torch>=2.2.0

COPY requirements.txt .
RUN pip install --no-cache-dir faiss-cpu>=1.8.0 && \
    pip install --no-cache-dir -r requirements.txt

COPY . .

EXPOSE 8000
CMD ["uvicorn", "serving.api:app", "--host", "0.0.0.0", "--port", "8000"]


# Dev stage — adds pytest/ruff/black on top of the runtime image.
# Kept as a separate stage so the image deployed to Cloud Run carries only
# runtime dependencies. Build with: --target dev
FROM runtime AS dev
COPY requirements-dev.txt .
RUN pip install --no-cache-dir -r requirements-dev.txt


# Deploy stage — runtime plus the artifacts the deployed scorer needs.
#
# Phase 2 deploys the KuaiRand scorer (item impression count; see
# docs/phase2_exposure_bias_plan.md), so only datastore/serving/ ships: an item
# table and a per-user seen-items index, about 2 MB.
#
# The whole of datastore/processed/ used to be copied. That directory now also
# holds analysis outputs — the phase 2b score dump alone is 615 MB — so copying
# it wholesale would put hundreds of megabytes of research artifacts into a
# serving image. The phase 1 (KuaiRec) two-stage path is therefore absent here;
# the API reports it as unavailable and /recommend returns 503 pointing at
# /recommend/kuairand.
FROM runtime AS deploy
COPY datastore/serving/ /app/datastore/serving/

# Cloud Run injects PORT and expects the container to listen on it.
ENV PORT=8080
CMD ["sh", "-c", "uvicorn serving.api:app --host 0.0.0.0 --port ${PORT:-8080}"]
